{
  "name": "@oomkapwn/memex",
  "version": "0.7.0",
  "description": "memex — MCP server for Obsidian vaults. Wikilinks, frontmatter, backlinks, basic Dataview, MCP resources & prompts. Read-only by default; opt-in writes.",
  "type": "module",
  "bin": {
    "memex-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "render:preview": "node scripts/render-social-preview.mjs",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "obsidian",
    "obsidian-md",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "memex",
    "wikilinks",
    "backlinks",
    "frontmatter",
    "dataview",
    "markdown",
    "pkm",
    "knowledge-management",
    "ai-agent"
  ],
  "author": "Alex (@OomkaBear)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomkapwn/memex.git"
  },
  "homepage": "https://github.com/oomkapwn/memex#readme",
  "bugs": {
    "url": "https://github.com/oomkapwn/memex/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
