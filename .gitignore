node_modules/
dist/
.env
.DS_Store
*.log
.vscode/
.idea/
.claude/
coverage/
.vitest-cache/
*.tgz
.npmrc
# Local bench output — hardware-specific. The numbers in README come from
# a fresh `npm run bench` on the maintainer's machine; contributors should
# generate their own and not commit them.
bench/results.md
bench/context-savings.json
# Note: bench/benchmarks.json (retrieval-quality bench) IS committed —
# `docs/benchmarks.md` references it as the canonical reproducible
# artifact. MRR/NDCG/Recall are bit-identical across hardware (only
# latency varies), so the committed values are a deterministic baseline.
# rc.16 — but its atomic-write scratch file is transient; never commit an orphan.
bench/*.tmp
# Generated TypeDoc API reference — built fresh by `npm run docs:api` on
# every push to main (see .github/workflows/publish-docs.yml) and
# deployed to GH Pages from there. Never commit the generated HTML.
docs/api-reference/
# Deterministic GitHub Pages upload artifact. It contains the landing page,
# a stable /api/ copy, and a legacy-path TypeDoc copy; CI rebuilds it.
.pages-dist/

# v3.9.0-rc.7 — stray npm cache tree created when an `npm` invocation
# mis-parses `--cache false` / `npm_config_cache=false` as a path. Junk;
# never commit. Guards against an accidental `git add .`.
false/

# Remote-CI-only MCPB assembly output. The checked-in manifest/icon source is
# under mcpb/; staged dependencies and timestamped bundle bytes are artifacts.
.mcpb-stage/
artifacts/*.mcpb
artifacts/*.content-manifest.json
artifacts/*.sbom.cdx.json
artifacts/*.third-party-licenses.json
artifacts/*.mcpb.sha256
artifacts/*.mcpb.provenance.json

# LongMemEval dataset (downloaded by the maintainer for bench:longmemeval; not committed — size + licensing)
longmemeval*.json
longmemeval_*/
